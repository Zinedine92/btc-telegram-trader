# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
PORT=10000

# Binance API Configuration
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Binance Mode: TESTNET or LIVE
# Default is TESTNET (safe)
# To use LIVE, you must also set ENABLE_LIVE_TRADING=YES
BINANCE_MODE=TESTNET

# Enable Live Trading (required only if BINANCE_MODE=LIVE)
# Set to "YES" to enable. Anything else disables it.
ENABLE_LIVE_TRADING=NO
